# Northgate Bank Document Chaser Copilot Configuration

# Optional: Google Gemini API Key for LLM generation
# If omitted or empty, the app runs in deterministic offline fallback mode with 100% functionality.
GEMINI_API_KEY=

# GCP Lab Approved Model: Gemini 3 Flash Preview (gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# GCP Configuration (Region restricted to asia-south1 per lab rules)
GOOGLE_CLOUD_PROJECT=
GCP_REGION=asia-south1
USE_VERTEX_AI=false

# Backend server configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend API URL configuration
VITE_API_URL=http://localhost:8000

# SQLite database file (/tmp/document_chaser.db on Cloud Run)
DB_PATH=document_chaser.db
